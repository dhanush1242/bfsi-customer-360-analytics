# Enterprise BFSI Customer 360 Configuration
ENVIRONMENT=development

# Database Configuration (Defaults to SQLite for instant local run, or PostgreSQL for production)
DB_TYPE=sqlite
# For PostgreSQL (Docker):
# DB_TYPE=postgres
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=bfsi_admin
# POSTGRES_PASSWORD=bfsi_secure_pass_2026
# POSTGRES_DB=bfsi_enterprise_dw

# Source Database (Operational Store)
SOURCE_DB_PATH=data/raw/bfsi_source_systems.db

# Target Data Warehouse (EDW Star Schema)
WAREHOUSE_DB_PATH=data/warehouse/bfsi_data_warehouse.db

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True
API_TITLE="Enterprise BFSI Customer 360 API"
API_VERSION="1.0.0"

# Synthetic Data Generation
DATA_SEED=42
NUM_CUSTOMERS=1200
NUM_ACCOUNTS=2200
NUM_LOANS=650
NUM_CARDS=900
NUM_TRANSACTIONS=25000
NUM_INTERACTIONS=4000
